<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:paddingVertical="@dimen/_18sdp">

    <View
        android:id="@+id/bar"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_2sdp"
        android:background="@color/textSec"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:fontFamily="@font/avenir_next_bold"
        android:text="Playback Options"
        android:textColor="@color/text_light"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bar" />

    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sheetTitle">

        <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
            android:id="@+id/playback_speed_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bolt_24px"
            app:title="Playback Speed" />

        <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
            android:id="@+id/sleep_timer_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/round_history_24"
            app:title="Sleep Timer" />

        <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
            android:id="@+id/equalizer_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/headphone"
            app:title="Equalizer" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
